{#case @voting_format}
  {#match "weighted_multiple"}
    {!-- choice_id rides along so the submit handler can map back to it;
         the weight lives in a hidden input that `phx-click` writes to. --}
    <input type="hidden" name={"votes[#{@index}][choice_id]"} value={id(@choice)}>
    {!-- Bind `choice_id` once via case-match so it's reused for ~7 ids
         and ~3 JS targets below, instead of recomputing `id/1 || @index`
         on each element (×6 buttons per choice gets pricey at scale). --}
    {#case id(@choice) || @index}
      {#match choice_id}
        <fieldset
          id={vote_dom_id(@id_prefix, "vote-input", choice_id)}
          role="radiogroup"
          phx-update="ignore"
          x-data="{
        selectedLabel: null,
        selectedTone: null,
        reduce: window.matchMedia('(prefers-reduced-motion: reduce)').matches,
        lastPulsedScore: null,
        // Runs on `poll:reacted`, which `choose_weight_js` fires after it flips
        // aria-checked: a click listener here would run before that and see the
        // previous pick.
        refresh() {
          const checked = $el.querySelector('button[role=radio][aria-checked=true]');
          if (checked) {
            this.selectedLabel = checked.dataset.label;
            this.selectedTone = checked.style.getPropertyValue('--tone');
            // Briefly pulse the chosen icon when the selection changes
            // (skip if reduce-motion or if it's the same score already selected).
            if (!this.reduce && this.lastPulsedScore !== checked.dataset.score) {
              const icon = checked.querySelector('[iconify]');
              if (icon && icon.animate) {
                icon.animate([
                  { transform: 'scale(1.1)' },
                  { transform: 'scale(1.3)' },
                  { transform: 'scale(1.1)' }
                ], { duration: 260, easing: 'cubic-bezier(0.22, 1, 0.36, 1)' });
              }
              this.lastPulsedScore = checked.dataset.score;
            }
          } else {
            this.selectedLabel = null;
            this.lastPulsedScore = null;
          }
        },
        moveFocus(dir) {
          const btns = [...$el.querySelectorAll('button[role=radio]')];
          if (!btns.length) return;
          const i = btns.findIndex(b => b === document.activeElement);
          const next = btns[(i < 0 ? 0 : i + dir + btns.length) % btns.length];
          btns.forEach(b => b.tabIndex = -1);
          next.tabIndex = 0;
          next.focus();
          next.click();
        }
      }"
          x-init="refresh()"
          x-on:poll:reacted="refresh()"
          x-on:keydown.right.prevent="moveFocus(1)"
          x-on:keydown.left.prevent="moveFocus(-1)"
          x-on:keydown.down.prevent="moveFocus(1)"
          x-on:keydown.up.prevent="moveFocus(-1)"
          class="group/react flex w-full items-stretch gap-1.5"
        >
          <legend class="sr-only">{l("Your reaction to this choice")}</legend>
          <input
            type="hidden"
            id={vote_dom_id(@id_prefix, "vote-weight", choice_id)}
            name={"votes[#{@index}][weight]"}
            value={chosen_value(@selected)}
          />

          {!-- The picked reaction, named in its tone at the row's top right
           (the decision row is `relative`; from `sm` the row has no padding),
           so nobody has to decode faces.
           Empty until a pick. --}
          <div
            data-role="vote-selected-callout"
            class="poll-tone-text absolute top-2.5 right-3.5 text-[13px]/[18px] font-medium whitespace-nowrap sm:top-1 sm:right-0"
            :style="`--tone: ${selectedTone}`"
            x-text="selectedLabel"
          />

          {!-- The five-step scale shares one track and stays monochrome until a
           pick; Block sits apart on its own (see `reaction_groups/1`), and
           while it's on the scale dims. Each face and Block names itself in a
           daisyUI tooltip on hover and focus, since faces alone don't say which
           is which; the full description stays in `aria-label`. The track fills the row and Block
           stretches to the track's height so the two line up. Cells are 36px
           for touch and 32px for a mouse. --}
          {#for {group, scores} <- reaction_groups(@scores)}
            <div
              data-role={if group == :scale, do: "reaction-scale"}
              class={[
                "grid flex-1 grid-cols-5 gap-0.5 p-[3px] rounded-field bg-(--poll-track) transition-opacity group-has-[[data-block][aria-checked=true]]/react:opacity-45":
                  group == :scale,
                contents: group == :block
              ]}
            >
              {#for {i, name, icon, description} <- scores}
                {!-- Buttons + aria-checked driven by Phoenix.LiveView.JS, not
                 native radios — LV form-state lifecycle clobbered the user's
                 selection between clicks on native ones. --}
                <button
                  type="button"
                  role="radio"
                  id={vote_dom_id(@id_prefix, "vote-btn", choice_id, score_key(i))}
                  aria-checked={if i == @selected, do: "true", else: "false"}
                  aria-label={"#{name}: #{description}"}
                  tabindex={roving_tabindex(i, @selected)}
                  phx-click={choose_weight_js(@id_prefix, choice_id, i)}
                  data-role="vote-score"
                  data-score={"#{i}"}
                  data-block={group == :block}
                  data-label={name}
                  data-tip={name}
                  style={"--tone: var(#{score_tone_var(i)})"}
                  class={[
                    "tooltip group inline-flex items-center justify-center cursor-pointer text-(--poll-meta) transition focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary/50 aria-checked:text-(--tone)",
                    "h-9 pointer-fine:h-8 rounded-[calc(var(--radius-field)-3px)] hover:text-base-content aria-checked:bg-(--poll-cell-raised) aria-checked:shadow-sm":
                      group == :scale,
                    "w-10 shrink-0 self-stretch rounded-field bg-(--poll-track) hover:text-(--tone) aria-checked:bg-[color-mix(in_oklab,var(--tone)_16%,transparent)] aria-checked:shadow-[inset_0_0_0_1.5px_var(--tone)]":
                      group == :block
                  ]}
                >
                  <Iconify.iconify
                    icon={icon}
                    class="size-5 transition group-aria-checked:scale-110"
                  />
                </button>
              {/for}
            </div>
          {/for}
        </fieldset>
    {/case}
  {#match "multiple"}
    <div id={vote_dom_id(@id_prefix, "vote-input", id(@choice) || "noid")} phx-update="ignore">
      {!-- A field per option, ringed once picked; the indicator stays muted
           until checked so the accent marks only the choice. Presets restyle it
           through the --poll-* tokens (app.css). --}
      <label data-role="vote-option" class={[
        "poll-option flex items-center gap-3 cursor-pointer transition-[background-color,box-shadow] has-checked:poll-picked",
        "hover:bg-(--poll-option-bg-hover)": !@readonly,
        "cursor-default": @readonly
      ]}>
        <input
          type="checkbox"
          name={"vote[#{id(@choice) || "_"}]"}
          value="1"
          checked={!!@selected}
          disabled={@readonly}
          class="checkbox checkbox-sm checkbox-primary rounded-(--poll-check-radius) not-checked:[--input-color:var(--poll-indicator-idle)]"
        />
        <div class="flex-1 min-w-0"><#slot /></div>
      </label>
    </div>
  {#match "single"}
    <div id={vote_dom_id(@id_prefix, "vote-input", id(@choice) || "noid")} phx-update="ignore">
      {!-- A field per option, ringed once picked; the indicator stays muted
           until checked so the accent marks only the choice. Presets restyle it
           through the --poll-* tokens (app.css). --}
      <label data-role="vote-option" class={[
        "poll-option flex items-center gap-3 cursor-pointer transition-[background-color,box-shadow] has-checked:poll-picked",
        "hover:bg-(--poll-option-bg-hover)": !@readonly,
        "cursor-default": @readonly
      ]}>
        <input
          type="radio"
          name="vote"
          value={id(@choice)}
          checked={@selected == 1 or @selected == true}
          disabled={@readonly}
          class="radio radio-sm radio-primary not-checked:[--input-color:var(--poll-indicator-idle)]"
        />
        <div class="flex-1 min-w-0"><#slot /></div>
      </label>
    </div>
  {#match _}
{/case}
