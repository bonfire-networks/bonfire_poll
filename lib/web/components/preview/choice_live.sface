{#case @voted_on}
  {#match voted_on}
    <div
      data-id="activity_choice"
      data-role="choice-row"
      data-rendered={@showing_within}
      data-main-object={@viewing_main_object}
      class={[
        "choice-row relative",
        # Group (consent) decisions carry no winner/veto emphasis — they show
        # the reaction results with no imposed outcome.
        "is-winner": @is_winner and @voting_format != "weighted_multiple",
        "is-vetoed": @is_vetoed and @voting_format != "weighted_multiple"
      ]}
      x-data="{ expanded: false, content_open: false }"
    >
      {#if @results_visible}
        {#if @voting_format == "weighted_multiple"}
          {!-- Consent results: one stacked bar per option, Disagree to Great in
               scale order, with Block counted beside it rather than in it (a
               veto, not a degree of agreement). No percentage and no verdict:
               everyone reacts to every option, and the group reads the spread
               itself. Under the bar, a count line names each reaction present,
               in its tone, with the viewer's own marked, so the numbers are
               visible on touch too and the bar itself can stay decorative. The
               bar and Block live in one `reaction-strip` for feed and thread
               alike; empty buckets stay in the DOM, hidden. The option text sits
               above its bar at every width, so long options wrap freely. Phones
               show each option as a card; from `sm` the card chrome goes, since
               a results list needs no card per row. --}
          <div
            data-role="consent-result"
            class="poll-card flex flex-col gap-2 sm:gap-1.5 sm:rounded-none sm:[border:0] sm:bg-transparent sm:px-0 sm:py-1"
          >
            <div class="min-w-0" data-role="decision-label">
              <ChoiceContentLive
                question={@question}
                object={@object}
                viewing_main_object={@viewing_main_object}
                showing_within={@showing_within}
                is_remote={@is_remote}
                hide_actions={@hide_actions}
                voting_format={@voting_format}
                vote={@vote}
                compact={@compact}
                is_winner={false}
              />
              {!-- Same on every option (everyone reacts to each), so it's only
                   for screen readers. --}
              <span :if={@viewing_main_object} class="sr-only" data-role="choice-participation">({@vote_count})</span>
            </div>

            {#case reaction_strip(@score_histogram)}
              {#match {scale, {block_value, _name, block_icon, block_count}}}
                <div class="flex items-center gap-2.5" data-role="reaction-strip">
                  <div class="flex h-2 flex-1 gap-0.5 overflow-hidden rounded-full bg-(--poll-track)" aria-hidden="true">
                    {#for {value, name, _icon, count} <- scale}
                      <span
                        class={["h-full basis-0 grow-(--n) bg-(--tone)", hidden: count == 0]}
                        style={"--n: #{count}; --tone: var(#{score_tone_var(value)})"}
                        title={"#{name}: #{count}"}
                        data-role="reaction-strip-bucket"
                        data-bucket={"#{value}"}
                        data-count={count}
                        data-mine={viewer_in_bucket?(@voted_on, @user_score, value)}
                      />
                    {/for}
                  </div>

                  <span
                    class={[
                      "shrink-0 items-center gap-1 text-[12px]/[16px] font-bold tabular-nums text-(--poll-tone-block)",
                      if(block_count > 0, do: "inline-flex", else: "hidden")
                    ]}
                    data-role="reaction-strip-bucket"
                    data-bucket={"#{block_value}"}
                    data-count={block_count}
                    data-mine={viewer_in_bucket?(@voted_on, @user_score, block_value)}
                  >
                    <Iconify.iconify icon={block_icon} class="size-3.5" aria-hidden="true" />
                    {blocks_label(block_count)}
                    {#if viewer_in_bucket?(@voted_on, @user_score, block_value)}
                      <span>· {l("you")}</span>
                    {/if}
                  </span>
                </div>

                <div
                  class="flex flex-wrap items-center gap-x-3 gap-y-0.5 text-[12px]/[16px] text-(--poll-meta) tabular-nums"
                  data-role="reaction-counts"
                >
                  {#for {value, name, _icon, count} <- Enum.filter(scale, &(elem(&1, 3) > 0))}
                    <span
                      class="inline-flex items-center gap-1.5"
                      style={"--tone: var(#{score_tone_var(value)})"}
                      data-role="reaction-count"
                      data-bucket={"#{value}"}
                      data-mine={viewer_in_bucket?(@voted_on, @user_score, value)}
                    >
                      <span class="size-2 shrink-0 rounded-[2px] bg-(--tone)" aria-hidden="true" />
                      {#if viewer_in_bucket?(@voted_on, @user_score, value)}
                        <span class="poll-tone-text font-medium">{name} {count} · {l("you")}</span>
                      {#else}
                        <span>{name} {count}</span>
                      {/if}
                    </span>
                  {/for}
                </div>
            {/case}
          </div>
        {#else}
          {!-- Tally poll: a real, honest share bar. For "single" the denominator
               is total votes; for "multiple" it's distinct voters, so each bar
               reads "share of voters who picked this" and bars need not sum to
               100% (correct for multi-select). --}
          {#case tally_percent(@voting_format, @vote_count, @total_votes, @voters_count)}
            {#match pct}
              {!-- Same geometry as the option row it replaces: the share bar fills
                   the row behind the label, so voting and results read as one
                   list. The count stays for screen readers; the % carries it on
                   screen. Only the final winner gets the accent bar. --}
              <div
                class="poll-option relative isolate flex items-center gap-3 overflow-hidden"
                data-role="choice-result"
                data-winner={@is_winner}
              >
                <div class="min-w-0 flex-1 flex flex-wrap items-center gap-x-2 gap-y-0.5 *:w-auto" data-role="choice-result-label">
                  <ChoiceContentLive
                    question={@question}
                    object={@object}
                    viewing_main_object={@viewing_main_object}
                    showing_within={@showing_within}
                    is_remote={@is_remote}
                    hide_actions={@hide_actions}
                    voting_format={@voting_format}
                    vote={@vote}
                    compact={@compact}
                    is_winner={@is_winner}
                  />

                  {#if voted_on}
                    <span class="inline-flex items-center gap-1 text-[12px]/[16px] font-medium text-(--poll-meta-strong)" data-role="your-vote">
                      <Iconify.iconify icon="ph:check-circle-fill" class="size-3.5 text-primary" />
                      <span>{l("Your vote")}</span>
                    </span>
                  {/if}
                </div>

                <span class="sr-only" data-role="choice-count">({@vote_count})</span>
                <span
                  class={[
                    "shrink-0 text-[15px]/[20px] tabular-nums",
                    "font-bold text-base-content": @is_winner,
                    "font-medium text-(--poll-meta-strong)": !@is_winner
                  ]}
                  data-role="choice-stats"
                >{pct}%</span>

                {!-- share bar: sweeps 0→pct on mount; reduced-motion starts at target --}
                <div data-role="share-bar" class="absolute inset-0 -z-10 rounded-[inherit]" role="img" aria-label={"#{pct}%"}>
                  <div
                    aria-hidden="true"
                    x-data={"{ w: window.matchMedia('(prefers-reduced-motion: reduce)').matches ? #{pct} : 0 }"}
                    x-init={"$nextTick(() => w = #{pct})"}
                    :style="`width: ${w}%`"
                    class={[
                      "h-full rounded-[inherit] motion-safe:transition-[width] motion-safe:duration-700 motion-safe:ease-[cubic-bezier(0.22,1,0.36,1)]",
                      "bg-(--poll-bar-winner)": @is_winner,
                      "bg-(--poll-bar)": !@is_winner
                    ]}
                  />
                </div>
              </div>
          {/case}
        {/if}
      {#elseif @vote and not voted_on and @voting_format == "weighted_multiple"}
        {!-- Two rows at every width: the option text on top, free to wrap, and
             the scale below, so long options never squeeze the controls. The
             picked reaction is named at the top right (`pr-24` keeps the label
             clear of it). Phones show each option as a card; from `sm` the
             chrome goes, as with the results, since the scale's track already
             groups each row. --}
        <div
          data-role="decision-row"
          class="poll-card relative flex flex-col gap-2 sm:gap-1.5 sm:rounded-none sm:[border:0] sm:bg-transparent sm:px-0 sm:py-1"
        >
          <div class="min-w-0 pr-24" data-role="decision-label">
            <ChoiceContentLive
              question={@question}
              object={@object}
              viewing_main_object={@viewing_main_object}
              showing_within={@showing_within}
              is_remote={@is_remote}
              hide_actions={@hide_actions}
              voting_format={@voting_format}
              vote={@vote}
              compact={@compact}
              is_winner={false}
            />
          </div>
          <VotingLive
            voting_format={@voting_format}
            question={@question}
            choice={@object}
            index={@index}
            selected={false}
            id_prefix={@id_prefix}
          />
        </div>
      {#elseif @vote and not voted_on}
        <div class="overflow-hidden motion-safe:transition-colors">
          <VotingLive
            voting_format={@voting_format}
            question={@question}
            choice={@object}
            index={@index}
            selected={false}
            id_prefix={@id_prefix}
          >
            <ChoiceContentLive
              question={@question}
              object={@object}
              viewing_main_object={@viewing_main_object}
              showing_within={@showing_within}
              is_remote={@is_remote}
              hide_actions={@hide_actions}
              voting_format={@voting_format}
              vote={@vote}
              compact={@compact}
              is_winner={false}
            />
          </VotingLive>
        </div>
      {#elseif voted_on and @voting_format == "weighted_multiple"}
        {!-- Reacted, results not shown yet: the card without the bar. --}
        <div class="poll-card flex flex-col gap-1">
          <div class="min-w-0">
            <ChoiceContentLive
              question={@question}
              object={@object}
              viewing_main_object={@viewing_main_object}
              showing_within={@showing_within}
              is_remote={@is_remote}
              hide_actions={@hide_actions}
              voting_format={@voting_format}
              vote={@vote}
              compact={@compact}
              is_winner={false}
            />
            {#case score_label(@user_score)}
              {#match nil}
              {#match {_v, name, icon, _desc}}
                <div
                  class="mt-1 inline-flex items-center gap-1.5 text-[12px]/[16px] text-(--poll-meta)"
                  data-role="your-score"
                  data-score={"#{@user_score}"}
                  style={"--tone: var(#{score_tone_var(@user_score)})"}
                >
                  <span>{l("Your reaction:")}</span>
                  <Iconify.iconify icon={icon} class="size-4 text-(--tone)" />
                  <span class="poll-tone-text font-medium">{name}</span>
                </div>
            {/case}
          </div>
        </div>
      {#elseif voted_on}
        {!-- Voted, results not shown yet: the option row, ringed and checked
             like a fresh pick. --}
        <div class="poll-option poll-picked flex items-center gap-3">
          <Iconify.iconify
            icon="ph:check-circle-fill"
            class="size-4 text-primary shrink-0"
            aria-label={l("Your vote")}
          />
          <div class="min-w-0 flex-1">
            <ChoiceContentLive
              question={@question}
              object={@object}
              viewing_main_object={@viewing_main_object}
              showing_within={@showing_within}
              is_remote={@is_remote}
              hide_actions={@hide_actions}
              voting_format={@voting_format}
              vote={@vote}
              compact={@compact}
              is_winner={false}
            />
          </div>
        </div>
      {#else}
        {!-- Read-only (signed out, results hidden, or a suggestion during the
             proposal phase): the option row without a live indicator. --}
        <div class="poll-option flex items-start gap-3">
          {#if @proposal_phase}
            {!-- Disabled vote-slot preview: signals 'this becomes votable
                 once the proposal phase closes.' Decorative only —
                 `aria-hidden` + `tabindex=-1` keep it out of the a11y tree. --}
            <input
              type="radio"
              disabled
              tabindex="-1"
              aria-hidden="true"
              data-role="proposal-vote-slot"
              class="radio radio-sm radio-primary mt-0.5 shrink-0 opacity-40 cursor-not-allowed [--input-color:var(--poll-indicator-idle)]"
            />
          {/if}
          <div class="flex-1 min-w-0">
            <ChoiceContentLive
              question={@question}
              object={@object}
              viewing_main_object={@viewing_main_object}
              showing_within={@showing_within}
              is_remote={@is_remote}
              hide_actions={@hide_actions}
              voting_format={@voting_format}
              vote={@vote}
              compact={@compact}
              is_winner={@is_winner}
            />
            {#if @show_author}
              {#case proposer_name(@object)}
                {#match nil}
                {#match author}
                  {#case proposer_username(@object)}
                    {#match nil}
                      <div class="mt-0.5 text-[12px]/[16px] text-(--poll-meta)" data-role="proposer">
                        {l("Suggested by %{name}", name: author)}
                      </div>
                    {#match username}
                      <div class="mt-0.5 text-[12px]/[16px] text-(--poll-meta)" data-role="proposer">
                        {l("Suggested by")}
                        <a href={"/@" <> username} class="link link-hover hover:text-base-content">@{username}</a>
                      </div>
                  {/case}
              {/case}
            {/if}
          </div>
        </div>
      {/if}
    </div>
{/case}
